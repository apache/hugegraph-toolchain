export LANG=zh_CN.UTF-8

function java_env_check() {
    which java >/dev/null 2>&1
    if [[ $? -ne 0 ]]; then
        echo "cannot find java in environment."
        exit 1
    fi
    local java_version
    java_version=$(java -version 2>&1 | sed -n 's/.*version "\([^"]*\)".*/\1/p' | head -1)
    local java_major=${java_version%%.*}
    if [[ ! "${java_major}" =~ ^[0-9]+$ ]] || [[ ${java_major} -lt 17 ]]; then
        echo "Hubble requires Java 17 or newer; found ${java_version:-unknown}." >&2
        exit 1
    fi
}

# read a property from .properties file
function read_property() {
    # file path
    local file_name=$1
    # replace "." to "\."
    local property_name=$(echo "$2" | sed 's/\./\\\./g')
    cat "${file_name}" | sed -n -e "s/^[ ]*//g;/^#/d;s/^$property_name=//p" | tail -1
}

# wait_for_startup friendly_name host port timeout_s
function wait_for_startup() {
    local server_url=$1
    local timeout_s=$2
    local now_s=$(date '+%s')
    local stop_s=$(( now_s + timeout_s ))
    local body=""
    local request_timeout_s=0
    local sleep_s=0

    while [[ ${now_s} -lt ${stop_s} ]]; do
        echo -n .
        request_timeout_s=$(( stop_s - now_s ))
        if [[ ${request_timeout_s} -gt 5 ]]; then
            request_timeout_s=5
        fi
        body=$(curl -fsS --connect-timeout 1 \
                    --max-time "${request_timeout_s}" \
                    "${server_url}" 2>/dev/null || true)
        if [[ "${body}" == *'"status":200'* &&
              "${body}" == *'"name":"hugegraph-hubble"'* ]]; then
            echo "OK"
            return 0
        fi
        now_s=$(date '+%s')
        if [[ ${now_s} -ge ${stop_s} ]]; then
            break
        fi
        sleep_s=$(( stop_s - now_s ))
        if [[ ${sleep_s} -gt 2 ]]; then
            sleep_s=2
        fi
        sleep "${sleep_s}"
        now_s=$(date '+%s')
    done

    echo "timed out waiting for HugeGraph Hubble readiness response" >&2
    return 1
}
