<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.hugegraph</groupId>
        <artifactId>hugegraph-toolchain</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hugegraph-toolchain-dist</artifactId>

    <properties>
        <release.name>${project.parent.artifactId}</release.name>
        <final.name>apache-${release.name}-${project.version}</final.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <tasks>
                                <!-- TODO: change to assembly plugin in future  -->
                                <echo file="${project.basedir}/dist.sh">
                                    root_path=$(cd $(dirname $0)/..; pwd)
                                    cd $root_path || exit

                                    mkdir -p ${final.name}
                                    mv -v $root_path/hugegraph-hubble/apache-hugegraph-hubble-${project.version} ${final.name}/ || exit
                                    mv -v $root_path/hugegraph-loader/apache-hugegraph-loader-${project.version} ${final.name}/ || exit
                                    mv -v $root_path/hugegraph-tools/apache-hugegraph-tools-${project.version} ${final.name}/ || exit
                                    cp -r -v $root_path/hugegraph-dist/release-docs/* ${final.name}/ || exit

                                    COPYFILE_DISABLE=1 tar zcvf "$root_path/target/${final.name}.tar.gz" \
                                        ./${final.name} || exit 1

                                    md5sum $root_path/target/${final.name}.tar.gz
                                    echo -n "hugegraph-toolchain tar.gz available at: "
                                    echo "$root_path/target/${final.name}.tar.gz"
                                    rm -f ${project.basedir}/dist.sh

                                </echo>
                                <delete file="${project.basedir}/../${final.name}/candidate-sdk-manifest.json"
                                        failonerror="true"/>
                                <copy todir="${project.basedir}/../${final.name}">
                                    <fileset dir="${settings.localRepository}">
                                        <include name="candidate-sdk-manifest.json"/>
                                    </fileset>
                                </copy>
                                <exec executable="python3" failonerror="true">
                                    <arg value="${project.basedir}/../.github/scripts/verify_candidate_image_sdk.py"/>
                                    <arg value="${settings.localRepository}"/>
                                    <arg value="--mode"/>
                                    <arg value="${sdk.validation.mode}"/>
                                    <arg value="--version"/>
                                    <arg value="${hugegraph.version}"/>
                                    <arg value="--distribution"/>
                                    <arg value="${project.basedir}/../hugegraph-loader/apache-hugegraph-loader-${project.version}"/>
                                    <arg value="--module"/>
                                    <arg value="loader"/>
                                </exec>
                                <exec executable="python3" failonerror="true">
                                    <arg value="${project.basedir}/../.github/scripts/verify_candidate_image_sdk.py"/>
                                    <arg value="${settings.localRepository}"/>
                                    <arg value="--mode"/>
                                    <arg value="${sdk.validation.mode}"/>
                                    <arg value="--version"/>
                                    <arg value="${hugegraph.version}"/>
                                    <arg value="--distribution"/>
                                    <arg value="${project.basedir}/../hugegraph-tools/apache-hugegraph-tools-${project.version}"/>
                                    <arg value="--module"/>
                                    <arg value="tools"/>
                                </exec>
                                <exec executable="python3" failonerror="true">
                                    <arg value="${project.basedir}/../.github/scripts/verify_candidate_image_sdk.py"/>
                                    <arg value="${settings.localRepository}"/>
                                    <arg value="--mode"/>
                                    <arg value="${sdk.validation.mode}"/>
                                    <arg value="--version"/>
                                    <arg value="${hugegraph.version}"/>
                                    <arg value="--distribution"/>
                                    <arg value="${project.basedir}/../hugegraph-hubble/apache-hugegraph-hubble-${project.version}"/>
                                    <arg value="--module"/>
                                    <arg value="hubble"/>
                                </exec>
                                <exec executable="${shell-executable}" dir="${project.basedir}" failonerror="true">
                                    <arg line="./dist.sh"/>
                                </exec>
                            </tasks>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}/..</directory>
                            <includes>
                                <include>${final.name}.tar.gz</include>
                            </includes>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
